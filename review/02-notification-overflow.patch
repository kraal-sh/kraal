+        assert!(matches!(rx.wait(Duration::ZERO), Wait::Overflow));
+        assert_eq!(bits(rx.reconcile(true)), PANES);
+        go.send(()).unwrap();
+        worker.join().unwrap();
+        assert!(matches!(rx.wait(Duration::ZERO), Wait::Overflow));
+        assert_eq!(bits(rx.reconcile(true)), 0, "a stale token is harmless");
+    }
+
+    #[test]
