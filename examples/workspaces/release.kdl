// The workspace the README shows: a production server, an agent and a live changelog.
// Copy it to ~/.config/kraal/workspaces/release.kdl, then open it with `kraal release`
// (the README saves it as shop.kdl, which `kraal shop` opens).
// Needs a checkout in ~/src/shop with a CHANGELOG.md, claude installed, and a server you
// reach as deploy@web-prod-1. Its pane gets a red frame: its name says "prod".

layout {
    cwd "~/src/shop"
    tab name="release" {
        pane split_direction="vertical" {
            pane command="ssh" { args "deploy@web-prod-1"; }
            pane split_direction="horizontal" {
                pane agent="claude"              // a shell that starts claude
                pane preview="CHANGELOG.md"      // a live Markdown preview
            }
        }
    }
}
